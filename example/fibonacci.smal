ifgt    # declaration: i - iterator, f - first number, g - second number, t - temporary

# initialization
f = 0
g = 1

> i     # get count from input

i > 0 @     # while i greater than 0
    < f     # print first number
    t = g   # store second number in temporary variable
    g + f   # calculate next number
    f = t   # update first number
    i - 1   # decrement iterator